{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", // Kritik: Vite gibi paketleyiciler için modül bulma mantığı
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "useDefineForClassFields": true,
    "skipLibCheck": true, // Kütüphane içindeki tip hatalarını görmezden gel (hız kazandırır)
    "allowJs": true,
    "esModuleInterop": true, // CommonJS ve ESM uyumu için
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [ "src" ]
}